; Engine configuration file.
config_version=5

[application]

config/quit_on_go_back=false
config/project_settings_override="user://override.cfg"

config/name="Vorn City"
config/description="Vorn City - Realistic open-world life roleplay"
config/version="0.9.0-vorn-city"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/img/vorn_logo.png"
boot_splash/bg_color=Color(0.01, 0.015, 0.03, 1)
boot_splash/show_image=false
config/windows_native_icon=""

[autoload]

Game="*res://scripts/game.gd"
Online="*res://scripts/online.gd"
Roleplay="*res://scripts/roleplay.gd"
Commerce="*res://scripts/commerce.gd"
Gangs="*res://scripts/gangs.gd"
Security="*res://scripts/security.gd"
Driving="*res://scripts/driving.gd"
Administration="*res://scripts/administration.gd"
Justice="*res://scripts/justice.gd"

[display]

window/handheld/orientation=4

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/driver.windows="opengl3_angle"
gl_compatibility/fallback_to_native=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.01, 0.015, 0.03, 1)
limits/opengl/max_lights_per_object=16
limits/opengl/max_renderable_lights=160
lights_and_shadows/directional_shadow/size=4096
