; Engine configuration file.
; AURUM STRIKE — Godot 4.6 (SAQR STUDIOS)

config_version=5

[application]

config/name="AURUM STRIKE"
config/description="أوروم سترايك — لعبة تصويب تكتيكية 5 ضد 5 من استوديوهات صقر"
config/version="2.1.0"
run/main_scene="res://game/boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://splash.png"

[autoload]

G="*res://game/main.gd"
Sfx="*res://game/sfx.gd"
Touch="*res://game/touch.gd"
Network="*res://game/network.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Cairo.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[internationalization]

rendering/root_node_layout_direction=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="items"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=64

[rendering]

renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/anisotropic_filtering_level.mobile=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.055, 1)
