extends SceneTree
## Bakes the island of Last Circle into assets/island so the battle royale can use it as a second map.
## The island is generated by Last Circle's own world script (from its pack); what it builds is captured into plain
## resources of this project, made lighter for phones:
##   pass 1 (ISLAND_PASS=1): every texture the island uses, downsized, as files in assets/island/tex
##   pass 2 (ISLAND_PASS=2, after an import): scenes and data
##     island_terrain.scn    terrain chunks
##     island_static.scn     each building merged per material (furniture as shared, reduced meshes), roads, walls, loose props
##     island_foliage.scn    trees and grass (multimeshes, grass drawn only near the camera)
##     island_collision.scn  every collider of the island in one static body
##     island_data.json      heights, ground types, places, roads, buildings, loot points with walking routes, spawns
## Run: LC_PCK=<LastCircle.pck> ISLAND_PASS=1|2 xvfb-run godot --path . --rendering-driver opengl3 --script res://tools/island/bake_island.gd

const OUT := "res://assets/island"
const SEED := 731
const TEX_MAX := 512
const PROP_MAX_TRIS := 3500

var world: Node3D
var ABS := ""               # OUT as a file-system path (res:// is read through the pack once it is mounted)
var manifest := {}          # source texture path -> baked file
var mat_cache := {}         # material id -> remapped material
var mesh_cache := {}        # mesh id -> saved reduced mesh
var stats := {}
var foliage_meshes := {}    # one shared copy of each tree / grass mesh

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	ABS = ProjectSettings.globalize_path(OUT)
	if not ProjectSettings.load_resource_pack(OS.get_environment("LC_PCK"), false):
		print("BAKE cannot open the pack")
		quit(2)
		return
	world = Node3D.new()
	world.set_script(load("res://scripts/world.gd"))
	get_root().add_child(world)
	world.call("build", SEED)
	for i in 3:
		await process_frame
	DirAccess.make_dir_recursive_absolute(ABS + "/tex")
	DirAccess.make_dir_recursive_absolute(ABS + "/meshes")
	if OS.get_environment("ISLAND_PASS") == "1":
		_pass_textures()
	else:
		_load_manifest()
		_pass_scenes()
	print("BAKE stats ", stats)
	quit(0)

# ================================================================== pass 1: textures
func _materials_of(n: Node) -> Array:
	var out := []
	if n is MeshInstance3D and (n as MeshInstance3D).mesh:
		var mi := n as MeshInstance3D
		for s in mi.mesh.get_surface_count():
			var m := mi.get_active_material(s)
			if m:
				out.append(m)
	if n is MultiMeshInstance3D and (n as MultiMeshInstance3D).multimesh and (n as MultiMeshInstance3D).multimesh.mesh:
		var mm := n as MultiMeshInstance3D
		if mm.material_override:
			out.append(mm.material_override)
		for s in mm.multimesh.mesh.get_surface_count():
			var m2 := mm.multimesh.mesh.surface_get_material(s)
			if m2:
				out.append(m2)
	return out

func _textures_of(m: Material) -> Array:
	## [property, texture] pairs of a material
	var out := []
	if m is ShaderMaterial:
		var sm := m as ShaderMaterial
		if sm.shader:
			for u in sm.shader.get_shader_uniform_list():
				var v = sm.get_shader_parameter(u["name"])
				if v is Texture2D:
					out.append([u["name"], v])
	else:
		for p in m.get_property_list():
			if p["type"] == TYPE_OBJECT:
				var v2 = m.get(p["name"])
				if v2 is Texture2D:
					out.append([p["name"], v2])
	if m.next_pass:
		out.append_array(_textures_of(m.next_pass))
	return out

func _pass_textures() -> void:
	var seen := {}
	for n in world.find_children("*", "", true, false):
		for m in _materials_of(n):
			for pair in _textures_of(m):
				var t: Texture2D = pair[1]
				var src := t.resource_path
				if src == "" or src.contains("::") or seen.has(src):
					continue
				seen[src] = true
				var img := t.get_image()
				if img == null:
					continue
				if img.is_compressed():
					img.decompress()
				var k := minf(1.0, float(TEX_MAX) / maxf(img.get_width(), img.get_height()))
				if k < 1.0:
					img.resize(maxi(4, int(img.get_width() * k)), maxi(4, int(img.get_height() * k)), Image.INTERPOLATE_LANCZOS)
				var base := src.get_file().get_basename()
				var alpha := img.detect_alpha() != Image.ALPHA_NONE
				var file := "%s.%s" % [base, "png" if alpha else "jpg"]
				if alpha:
					img.convert(Image.FORMAT_RGBA8)
					img.save_png(ABS + "/tex/" + file)
				else:
					img.convert(Image.FORMAT_RGB8)
					img.save_jpg(ABS + "/tex/" + file, 0.9)
				manifest[src] = OUT + "/tex/" + file
	var f := FileAccess.open(ABS + "/tex/manifest.json", FileAccess.WRITE)
	f.store_string(JSON.stringify(manifest, " "))
	stats["textures"] = manifest.size()

func _load_manifest() -> void:
	manifest = JSON.parse_string(FileAccess.get_file_as_string(ABS + "/tex/manifest.json"))

# ================================================================== pass 2: scenes and data
func _remat(m: Material) -> Material:
	if m == null:
		return null
	var key := m.get_instance_id()
	if mat_cache.has(key):
		return mat_cache[key]
	var d := m.duplicate() as Material
	d.resource_path = ""
	for pair in _textures_of(d):
		var t: Texture2D = pair[1]
		if manifest.has(t.resource_path):
			var nt := load(manifest[t.resource_path]) as Texture2D
			if d is ShaderMaterial:
				(d as ShaderMaterial).set_shader_parameter(pair[0], nt)
			else:
				d.set(pair[0], nt)
	if d.next_pass:
		d.next_pass = _remat(d.next_pass)
	mat_cache[key] = d
	return d

func _tris(m: Mesh) -> int:
	var t := 0
	for s in m.get_surface_count():
		var a := m.surface_get_arrays(s)
		t += (a[Mesh.ARRAY_INDEX] as PackedInt32Array).size() / 3 if a[Mesh.ARRAY_INDEX] != null else (a[Mesh.ARRAY_VERTEX] as PackedVector3Array).size() / 3
	return t

func _reduced(m: Mesh, name_hint: String) -> Mesh:
	## a prop mesh with its own materials remapped; dense ones replaced by a simplified level of detail, with LODs
	var key := m.get_instance_id()
	if mesh_cache.has(key):
		return mesh_cache[key]
	var im := ImporterMesh.new()
	for s in m.get_surface_count():
		var arr := m.surface_get_arrays(s)
		im.add_surface(m.surface_get_primitive_type(s), arr, [], {}, _remat(m.surface_get_material(s)))
	var tris := _tris(m)
	if tris > PROP_MAX_TRIS:
		im.generate_lods(25.0, 60.0, [])
		var im2 := ImporterMesh.new()
		for s in im.get_surface_count():
			var arr2 := im.get_surface_arrays(s)
			var full := (arr2[Mesh.ARRAY_INDEX] as PackedInt32Array).size() / 3
			var want := maxi(int(PROP_MAX_TRIS * full / maxf(tris, 1.0)), 60)
			for l in im.get_surface_lod_count(s):
				var idx := im.get_surface_lod_indices(s, l)
				if idx.size() / 3 >= want or l == 0:
					arr2[Mesh.ARRAY_INDEX] = idx
				if idx.size() / 3 < want:
					break
			im2.add_surface(im.get_surface_primitive_type(s), arr2, [], {}, im.get_surface_material(s))
		im = im2
	im.generate_lods(25.0, 60.0, [])
	var out := im.get_mesh()
	var fname := "%s_%d.res" % [name_hint.validate_filename(), mesh_cache.size()]
	ResourceSaver.save(out, ABS + "/meshes/" + fname, ResourceSaver.FLAG_COMPRESS)
	var saved := load(ABS + "/meshes/" + fname) as Mesh
	saved.take_over_path(OUT + "/meshes/" + fname)
	mesh_cache[key] = saved
	stats["prop_meshes"] = mesh_cache.size()
	stats["prop_tris_before"] = int(stats.get("prop_tris_before", 0)) + tris
	stats["prop_tris_after"] = int(stats.get("prop_tris_after", 0)) + _tris(saved)
	return saved

func _is_prop(m: Mesh) -> bool:
	return m.resource_path.contains(".gltf") or m.resource_path.contains(".glb")

func _top(n: Node) -> Node:
	var t := n
	while t.get_parent() != world:
		t = t.get_parent()
	return t

func _own(n: Node, o: Node) -> void:
	for c in n.get_children():
		c.owner = o
		_own(c, o)

func _save_scene(root: Node, path: String) -> void:
	_own(root, root)
	var ps := PackedScene.new()
	ps.pack(root)
	var err := ResourceSaver.save(ps, ProjectSettings.globalize_path(path) if false else ABS + "/" + path.get_file(), ResourceSaver.FLAG_COMPRESS)
	var deps := ResourceLoader.get_dependencies(ABS + "/" + path.get_file())
	var foreign: Array = []
	for d in deps:
		if d.contains("res://scripts") or d.contains("res://assets/props") or d.contains("res://assets/tex/") or d.contains("res://assets/characters"):
			foreign.append(d)
	print("BAKE saved %s err %d deps %d foreign %d" % [path, err, deps.size(), foreign.size()])
	for d in foreign.slice(0, 5):
		print("   foreign: ", d)

class Merger:
	## static geometry gathered per material (and vertex format) into a few meshes
	var groups := {}
	func add(mesh: Mesh, s: int, xf: Transform3D, mat: Material) -> void:
		var arr := mesh.surface_get_arrays(s)
		var fmt := ""
		for a in [Mesh.ARRAY_NORMAL, Mesh.ARRAY_TANGENT, Mesh.ARRAY_COLOR, Mesh.ARRAY_TEX_UV, Mesh.ARRAY_TEX_UV2]:
			fmt += "1" if arr[a] != null and arr[a].size() > 0 else "0"
		var key := "%d_%s" % [mat.get_instance_id() if mat else 0, fmt]
		if not groups.has(key):
			var st := SurfaceTool.new()
			st.begin(Mesh.PRIMITIVE_TRIANGLES)
			groups[key] = [st, mat]
		var am := mesh as ArrayMesh
		if am == null:
			am = ArrayMesh.new()
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
			(groups[key][0] as SurfaceTool).append_from(am, 0, xf)
		else:
			(groups[key][0] as SurfaceTool).append_from(am, s, xf)
	func build(parent: Node3D, name_hint: String, range_end: float) -> void:
		var i := 0
		for k in groups:
			var st: SurfaceTool = groups[k][0]
			var mesh := st.commit()
			if mesh.get_surface_count() == 0:
				continue
			mesh.surface_set_material(0, groups[k][1])
			var mi := MeshInstance3D.new()
			mi.name = "%s_%d" % [name_hint, i]
			mi.mesh = mesh
			if range_end > 0.0:
				mi.visibility_range_end = range_end
			parent.add_child(mi)
			i += 1

func _pass_scenes() -> void:
	var regions: Array = world.get("building_regions")
	var bnode := {}
	for r in regions:
		bnode[r["node"]] = r
	# ---- terrain
	var terrain := Node3D.new()
	terrain.name = "IslandTerrain"
	# ---- buildings and the rest of the static geometry
	var stat := Node3D.new()
	stat.name = "IslandStatic"
	var merges := {}            # top node -> Merger
	var props := {}             # top node -> [[mesh, xf], ...]
	var foliage := Node3D.new()
	foliage.name = "IslandFoliage"
	var body := StaticBody3D.new()
	body.name = "IslandBody"
	var n_shapes := 0
	for n in world.find_children("*", "", true, false):
		var top := _top(n)
		var is_terrain := String(top.name).begins_with("Terrain")
		if n is CollisionShape3D and (n as CollisionShape3D).shape:
			var cs := CollisionShape3D.new()
			cs.shape = (n as CollisionShape3D).shape
			cs.transform = (n as Node3D).global_transform
			body.add_child(cs)
			n_shapes += 1
			continue
		if n is MultiMeshInstance3D and (n as MultiMeshInstance3D).multimesh and (n as MultiMeshInstance3D).multimesh.mesh:
			var src := n as MultiMeshInstance3D
			var mm := src.multimesh.duplicate() as MultiMesh
			var mkey := src.multimesh.mesh.get_instance_id()
			if not foliage_meshes.has(mkey):
				var fm := src.multimesh.mesh.duplicate() as Mesh
				for s in fm.get_surface_count():
					fm.surface_set_material(s, _remat(fm.surface_get_material(s)))
				foliage_meshes[mkey] = fm
			var mesh: Mesh = foliage_meshes[mkey]
			mm.mesh = mesh
			var dst := MultiMeshInstance3D.new()
			dst.multimesh = mm
			dst.material_override = _remat(src.material_override)
			dst.transform = src.global_transform
			dst.cast_shadow = src.cast_shadow
			var tall := mesh.get_aabb().size.y > 2.5
			dst.visibility_range_end = 700.0 if tall else 70.0
			dst.visibility_range_end_margin = 10.0
			dst.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
			if not tall:
				dst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			foliage.add_child(dst)
			stats["foliage_instances"] = int(stats.get("foliage_instances", 0)) + mm.instance_count
			continue
		if not (n is MeshInstance3D) or (n as MeshInstance3D).mesh == null or not (n as MeshInstance3D).is_visible_in_tree():
			continue
		var mi := n as MeshInstance3D
		if is_terrain:
			var t := MeshInstance3D.new()
			t.mesh = mi.mesh.duplicate()
			for s in t.mesh.get_surface_count():
				t.mesh.surface_set_material(s, _remat(mi.get_active_material(s)))
			t.transform = mi.global_transform
			terrain.add_child(t)
			continue
		var base := (top as Node3D).global_transform if top is Node3D else Transform3D.IDENTITY
		var xf := base.affine_inverse() * mi.global_transform
		if _is_prop(mi.mesh):
			if not props.has(top):
				props[top] = []
			(props[top] as Array).append([_reduced(mi.mesh, mi.mesh.resource_path.get_file().get_basename()), xf])
		else:
			if not merges.has(top):
				merges[top] = Merger.new()
			for s in mi.mesh.get_surface_count():
				(merges[top] as Merger).add(mi.mesh, s, xf, _remat(mi.get_active_material(s)))
	stats["shapes"] = n_shapes
	var tops := {}
	for k in merges:
		tops[k] = true
	for k in props:
		tops[k] = true
	var bi := 0
	for top in tops:
		var holder := Node3D.new()
		var is_b := bnode.has(top)
		holder.name = String(top.name).validate_node_name() if is_b else "Misc_%d" % bi
		bi += 1
		holder.transform = (top as Node3D).global_transform if top is Node3D else Transform3D.IDENTITY
		stat.add_child(holder)
		if merges.has(top):
			(merges[top] as Merger).build(holder, "part", 0.0)
		if props.has(top):
			# props of one kind under one top node become a multimesh (furniture drawn up to 120 m)
			var by_mesh := {}
			for pr in props[top]:
				var mk: Mesh = pr[0]
				if not by_mesh.has(mk):
					by_mesh[mk] = []
				(by_mesh[mk] as Array).append(pr[1])
			for mk in by_mesh:
				var xs: Array = by_mesh[mk]
				var mmi := MultiMeshInstance3D.new()
				var mm2 := MultiMesh.new()
				mm2.transform_format = MultiMesh.TRANSFORM_3D
				mm2.mesh = mk
				mm2.instance_count = xs.size()
				for j in xs.size():
					mm2.set_instance_transform(j, xs[j])
				mmi.multimesh = mm2
				mmi.visibility_range_end = 120.0 if is_b else 500.0
				mmi.visibility_range_end_margin = 10.0
				mmi.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
				holder.add_child(mmi)
	_save_scene(terrain, OUT + "/island_terrain.scn")
	_save_scene(stat, OUT + "/island_static.scn")
	_save_scene(foliage, OUT + "/island_foliage.scn")
	_save_scene(body, OUT + "/island_collision.scn")
	_save_data()

# ------------------------------------------------------------------ data
func _v3(v: Vector3) -> Array:
	return [snappedf(v.x, 0.01), snappedf(v.y, 0.01), snappedf(v.z, 0.01)]

func _save_data() -> void:
	var half: float = world.get("WORLD_HALF") if world.get("WORLD_HALF") != null else 500.0
	var n := 257
	var step := half * 2.0 / float(n - 1)
	var hs := []
	var surf := []
	var codes := {}
	for zi in n:
		for xi in n:
			var x := -half + xi * step
			var z := -half + zi * step
			hs.append(snappedf(float(world.call("height_at", x, z)), 0.01))
			var s := String(world.call("surface_at", Vector3(x, 0, z)))
			if not codes.has(s):
				codes[s] = codes.size()
			surf.append(codes[s])
	var regions := []
	for r in world.get("building_regions"):
		regions.append({"c": [r["position"].x, r["position"].y], "size": [r["size"].x, r["size"].y], "rot": r["rotation"], "h": r["height"], "kind": r["kind"], "name": String((r["node"] as Node).name)})
	var places := []
	var roads := []
	for f in world.call("get_map_features"):
		if f["type"] == "settlement":
			places.append({"name": f["name"], "c": [f["position"].x, f["position"].y]})
		elif f["type"] == "road":
			var pts := []
			for p in f["points"]:
				pts.append([p.x, p.y])
			roads.append({"points": pts, "width": f.get("width", 8.0)})
	# loot with the walk in from outside, along the island's own navigation
	var loot := []
	var routes_ok := 0
	for lp in world.get("loot_spawns"):
		var p: Vector3 = lp
		var inside := ""
		var best_path: Array = []
		for r in world.get("building_regions"):
			var c: Vector2 = r["position"]
			var sz: Vector2 = r["size"]
			var local := Vector2(p.x - c.x, p.z - c.y).rotated(-float(r["rotation"]))
			if absf(local.x) <= sz.x * 0.5 + 0.5 and absf(local.y) <= sz.y * 0.5 + 0.5:
				inside = String((r["node"] as Node).name)
				var bestlen := INF
				for side in [Vector2(0, 1), Vector2(0, -1), Vector2(1, 0), Vector2(-1, 0)]:
					var off := Vector2(side.x * (sz.x * 0.5 + 5.0), side.y * (sz.y * 0.5 + 5.0)).rotated(float(r["rotation"]))
					var from := Vector3(c.x + off.x, 0, c.y + off.y)
					from.y = float(world.call("height_at", from.x, from.z)) + 0.3
					var rt = world.call("route", from, p)
					if rt == null or rt.size() < 2:
						continue
					var ln := 0.0
					for i in range(1, rt.size()):
						ln += (rt[i] as Vector3).distance_to(rt[i - 1])
					if ln < bestlen:
						bestlen = ln
						best_path = []
						var last := Vector3.INF
						for q in rt:
							if last == Vector3.INF or (q as Vector3).distance_to(last) > 2.5:
								best_path.append(_v3(q))
								last = q
				break
		if not best_path.is_empty():
			routes_ok += 1
		loot.append({"p": _v3(p), "in": inside, "path": best_path})
	stats["loot"] = loot.size()
	stats["loot_routes"] = routes_ok
	var to_list := func(a: Array) -> Array:
		var o := []
		for v in a:
			o.append(_v3(v))
		return o
	var data := {"half": half, "n": n, "step": step, "heights": hs, "surface": surf, "surface_codes": codes, "buildings": regions, "places": places,
		"roads": roads, "loot": loot, "bots": to_list.call(world.get("bot_spawns")), "vehicles": to_list.call(world.get("vehicle_spawns")),
		"cover": to_list.call(world.get("cover_points")), "player": _v3(world.get("player_spawn"))}
	var f2 := FileAccess.open(ABS + "/island_data.json", FileAccess.WRITE)
	f2.store_string(JSON.stringify(data))
	print("BAKE data: %d heights, codes %s, %d places, %d roads, %d loot (%d routed)" % [hs.size(), codes, places.size(), roads.size(), loot.size(), routes_ok])
